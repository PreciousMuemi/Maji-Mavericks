NZOIA_LLM_PROVIDER=anthropic
# Set the key for the selected provider. Never commit real credentials.
NZOIA_OPENAI_API_KEY=
NZOIA_GEMINI_API_KEY=
NZOIA_OPENROUTER_API_KEY=
NZOIA_ANTHROPIC_API_KEY=
NZOIA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional override. Claude Haiku is the default Anthropic model for this service.
# NZOIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NZOIA_LLM_MODEL=claude-haiku-5-5
# NZOIA_LLM_MODEL=
NZOIA_LLM_TIMEOUT_SECONDS=60
NZOIA_LLM_MAX_OUTPUT_TOKENS=32768
NZOIA_MAX_UPLOAD_BYTES=10000000
NZOIA_MAX_DOCUMENT_CHARACTERS=150000
NZOIA_MAX_ARCHIVE_UNCOMPRESSED_BYTES=50000000
NZOIA_MAX_TOOL_ROUNDS=4
NZOIA_STORAGE_DIRECTORY=.nzoia-data
NZOIA_DATASET_DIRECTORY=../datasets
# Set a long random shared token before exposing the service beyond localhost.
NZOIA_API_TOKEN=
# Rich insurance extraction: section size and review threshold (not calibrated confidence).
NZOIA_EXTRACTION_SECTION_CHARACTERS=8000
NZOIA_EXTRACTION_REVIEW_CONFIDENCE=0.85
# Optional local integration test input; never include confidential files in public commits.
# NZOIA_SAMPLE_OFFER_PATH=/absolute/path/OFFER_NZOIA_GRAIN_PROCESSING.pdf
# NZOIA_RUN_LIVE_EXTRACTION=1
# Underwriting agent limits, including the initial assessment context call.
NZOIA_MAX_AGENT_TOOL_CALLS=16
NZOIA_AGENT_TOOL_TIMEOUT_SECONDS=30
NZOIA_AGENT_CHAT_TIMEOUT_SECONDS=120
